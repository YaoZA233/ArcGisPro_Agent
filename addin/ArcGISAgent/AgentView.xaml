<UserControl x:Class="ArcGISAgent.AgentView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 MinWidth="285" Background="{DynamicResource Page}" Foreground="{DynamicResource Ink}"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" AllowDrop="True" Drop="Files_Drop" DragOver="Files_DragOver">
 <UserControl.Resources>
  <SolidColorBrush x:Key="Page" Color="#F7F8FA"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Ink" Color="#1B2838"/>
  <SolidColorBrush x:Key="Muted" Color="#6B7B8D"/>
  <SolidColorBrush x:Key="Line" Color="#E2E6EB"/>
  <SolidColorBrush x:Key="Accent" Color="#2B6CB0"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#EBF2FA"/>
  <SolidColorBrush x:Key="Hover" Color="#F0F2F5"/>
  <SolidColorBrush x:Key="Warning" Color="#FEF3EB"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <!-- Button Style — minimal, pill-shaped -->
  <Style TargetType="Button" x:Key="SoftButton">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,6"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="MinHeight" Value="30"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource SoftButton}"/>
  <!-- Primary button — filled accent -->
  <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource SoftButton}">
   <Setter Property="Background" Value="{DynamicResource Accent}"/>
   <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- Icon button — no border, compact -->
  <Style TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource SoftButton}">
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="6"/>
   <Setter Property="MinHeight" Value="28"/>
   <Setter Property="MinWidth" Value="28"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="Padding" Value="10,8"/>
   <Setter Property="SelectionBrush" Value="#5B8DB5"/>
   <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="32"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="Caption">
   <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
   <Setter Property="FontWeight" Value="Normal"/>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- ═══ ROW 0 — COMPACT TOOLBAR ═══ -->
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
   <DockPanel>
    <!-- Right side: quick actions -->
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="UpdateButton" Style="{StaticResource SoftButton}" Content="有更新" Click="Update_Click" Visibility="Collapsed" Margin="0,0,6,0" ToolTip="查看可用更新"/>
     <Button x:Name="NewButton" Style="{StaticResource IconButton}" Content="✚" Click="Reset_Click" ToolTip="新对话" FontSize="14"/>
     <Button x:Name="HistoryButton" Style="{StaticResource IconButton}" Content="⏱" Click="History_Click" ToolTip="历史记录" FontSize="14" Margin="2,0"/>
     <Button x:Name="ExportButton" Style="{StaticResource IconButton}" Content="↗" Click="Export_Click" ToolTip="导出对话" FontSize="14" Margin="0,0,2,0"/>
     <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Content="◑" Click="Theme_Click" ToolTip="切换浅色 / 深色" FontSize="14"/>
    </StackPanel>
    <!-- Left side: title & status inline -->
    <StackPanel VerticalAlignment="Center">
     <DockPanel>
      <TextBlock Text="GIS Workspace" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" Text="正在连接…" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <TextBlock x:Name="ActualModelText" Text="deepseek-flash" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- ═══ ROW 1 — SETTINGS (single-level expander) ═══ -->
  <Expander Grid.Row="1" x:Name="SettingsPanel" Margin="12,6,12,4" Foreground="{DynamicResource Ink}" FontSize="12">
   <Expander.Header>
    <TextBlock Text="⚙  设置" FontWeight="SemiBold" FontSize="12"/>
   </Expander.Header>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,0">
    <ScrollViewer x:Name="SettingsScroll" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="SettingsContent" Margin="0,0,4,0">

     <!-- Connection -->
     <TextBlock Text="连接" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
     <ComboBox x:Name="ProviderCombo" SelectionChanged="Provider_Changed" AutomationProperties.Name="当前连接" Margin="0,0,0,6"/>
     <TextBlock x:Name="ProviderStatusText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

     <!-- Connection Manager (nested) -->
     <Expander x:Name="ConnectionManager" Margin="0,0,0,10">
      <Expander.Header><TextBlock Text="管理连接" FontSize="11" Foreground="{DynamicResource Muted}"/></Expander.Header>
      <StackPanel Margin="0,8,0,0">
       <TextBlock Text="供应商预设" Style="{StaticResource Caption}"/>
       <ComboBox x:Name="PresetCombo" SelectionChanged="Preset_Changed" AutomationProperties.Name="供应商预设"/>
       <Button Content="从预设新建连接" Click="NewConnection_Click" Margin="0,8,0,10"/>
       <TextBlock Text="连接 ID" Style="{StaticResource Caption}"/>
       <TextBox x:Name="ConnectionIdBox" AutomationProperties.Name="连接 ID"/>
       <TextBlock Text="显示名称" Style="{StaticResource Caption}" Margin="0,8,0,5"/>
       <TextBox x:Name="ConnectionNameBox" AutomationProperties.Name="连接显示名称"/>
       <TextBlock Text="API 协议" Style="{StaticResource Caption}" Margin="0,8,0,5"/>
       <ComboBox x:Name="ProtocolCombo" SelectedIndex="0" AutomationProperties.Name="API 协议">
        <ComboBoxItem Content="OpenAI 兼容" Tag="openai"/><ComboBoxItem Content="Claude 原生" Tag="anthropic"/>
       </ComboBox>
       <TextBlock Text="Base URL" Style="{StaticResource Caption}" Margin="0,8,0,5"/>
       <TextBox x:Name="EndpointBox" AutomationProperties.Name="API 接口地址"/>
       <TextBlock Text="API Key" Style="{StaticResource Caption}" Margin="0,8,0,5"/>
       <PasswordBox x:Name="ApiKeyBox" Padding="8" AutomationProperties.Name="API 密钥"/>
       <TextBlock Text="默认模型" Style="{StaticResource Caption}" Margin="0,8,0,5"/>
       <TextBox x:Name="DefaultModelBox" AutomationProperties.Name="连接默认模型"/>
       <TextBlock Text="推理模式" Style="{StaticResource Caption}" Margin="0,8,0,5"/>
       <ComboBox x:Name="ReasoningModeCombo" AutomationProperties.Name="推理参数模式"/>
       <CheckBox x:Name="VisionCapability" Content="支持图片输入" Margin="0,10,0,0"/>
       <CheckBox x:Name="ToolsCapability" Content="启用工具调用" Margin="0,6,0,0"/>
       <CheckBox x:Name="StreamUsageCapability" Content="流式 token 用量" Margin="0,6,0,0"/>
       <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Button Content="保存并启用" Click="SaveConnection_Click" Style="{StaticResource PrimaryButton}"/>
        <Button Grid.Column="2" Content="删除连接" Click="DeleteConnection_Click"/>
       </Grid>
       <TextBlock Text="密钥仅保存在本机 .env.local。" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
      </StackPanel>
     </Expander>

     <!-- Separator -->
     <Border Height="1" Background="{DynamicResource Line}" Margin="0,2,0,10"/>

     <!-- Model -->
     <TextBlock Text="模型" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="ModelCombo" IsEditable="True" Text="deepseek-flash" AutomationProperties.Name="模型名称"><ComboBoxItem Content="deepseek-flash"/><ComboBoxItem Content="deepseek-v4-pro"/></ComboBox>
      <Button Grid.Column="1" x:Name="RefreshModelsButton" Content="刷新" Click="RefreshModels_Click" Margin="6,0,0,0" ToolTip="从接口获取模型列表"/>
     </Grid>

     <!-- Row: thinking + max tokens side by side -->
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="思考程度" Style="{StaticResource Caption}"/>
       <ComboBox x:Name="ThinkingCombo" SelectedIndex="2" AutomationProperties.Name="思考程度">
        <ComboBoxItem Content="关闭" Tag="off"/><ComboBoxItem Content="轻量" Tag="low"/><ComboBoxItem Content="深入" Tag="high"/><ComboBoxItem Content="充分" Tag="max"/>
       </ComboBox>
      </StackPanel>
      <StackPanel Grid.Column="2">
       <TextBlock Text="最大输出" Style="{StaticResource Caption}"/>
       <ComboBox x:Name="MaxTokensCombo" IsEditable="True" Text="8192" AutomationProperties.Name="最大输出 tokens"><ComboBoxItem Content="4096"/><ComboBoxItem Content="8192"/><ComboBoxItem Content="16384"/><ComboBoxItem Content="32768"/></ComboBox>
      </StackPanel>
     </Grid>

     <TextBlock Text="图片精度" Style="{StaticResource Caption}" Margin="0,10,0,5"/>
     <ComboBox x:Name="ImageDetailCombo" SelectedIndex="0" AutomationProperties.Name="图片精度"><ComboBoxItem Content="自动" Tag="auto"/><ComboBoxItem Content="低 · 更快" Tag="low"/><ComboBoxItem Content="高 · 细节" Tag="high"/></ComboBox>

     <CheckBox x:Name="ShowReasoning" Content="显示推理内容" IsChecked="True" Margin="0,12,0,0"/>
     <CheckBox x:Name="MotionToggle" Content="启用动效" IsChecked="True" Margin="0,6,0,0"/>

     <Button x:Name="ApplySettingsButton" Content="应用" Click="ApplySettings_Click" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0"/>
     <TextBlock Text="新设置用于后续请求。" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
    </StackPanel>
    </ScrollViewer>
   </Border>
  </Expander>

  <!-- ═══ ROW 2 — TRANSCRIPT ═══ -->
  <Grid Grid.Row="2">
   <ScrollViewer x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
    <StackPanel x:Name="Transcript"/>
   </ScrollViewer>
   <!-- History overlay -->
   <Border x:Name="HistoryPanel" Visibility="Collapsed" Background="{DynamicResource Page}" Padding="14">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="对话记录" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock Text="选择后恢复上下文。" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" FontSize="12"/>
     </StackPanel>
     <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button Content="返回" Click="CloseHistory_Click"/>
      <Button Grid.Column="2" Content="恢复对话" Click="LoadHistory_Click" Style="{StaticResource PrimaryButton}"/>
     </Grid>
     <ListBox x:Name="HistoryList" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" DisplayMemberPath="Title" MouseDoubleClick="LoadHistory_Click"/>
    </DockPanel>
   </Border>
  </Grid>

  <!-- ═══ ROW 3 — STATUS BAR (token stats, inline) ═══ -->
  <Border Grid.Row="3" Padding="12,4,12,4" Background="{DynamicResource Page}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
   <StackPanel>
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" x:Name="ElapsedText" Text="" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="↑" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <TextBlock x:Name="InputTokens" Text="—" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,0,8,0" VerticalAlignment="Center"/>
      <TextBlock Text="↓" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <TextBlock x:Name="OutputTokens" Text="—" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,0,8,0" VerticalAlignment="Center"/>
      <TextBlock Text="⚡" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <TextBlock x:Name="CacheTokens" Text="—" FontSize="11" Foreground="{DynamicResource Muted}" Margin="2,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </DockPanel>
    <ProgressBar x:Name="ActivityBar" Height="2" IsIndeterminate="True" Foreground="{DynamicResource Accent}" Margin="0,3,0,0" Visibility="Collapsed"/>
   </StackPanel>
  </Border>

  <!-- ═══ ROW 4 — APPROVAL CARD + COMPOSER ═══ -->
  <StackPanel Grid.Row="4">
   <!-- Approval -->
   <Border x:Name="ApprovalCard" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Margin="12,6,12,6" Padding="14">
    <StackPanel>
     <TextBlock x:Name="ApprovalTitle" Text="等待授权" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource Ink}" FontSize="13"/>
     <TextBlock x:Name="ApprovalSelectionSummary" Visibility="Collapsed" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Accent}" FontSize="12"/>
     <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,8">
      <TextBox x:Name="ApprovalDetails" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" AutomationProperties.Name="操作参数" Foreground="{DynamicResource Muted}" FontSize="12"/>
     </ScrollViewer>
     <TextBlock Text="仅授权此操作，后续仍需确认。" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
     <WrapPanel x:Name="ApprovalButtons">
      <Button x:Name="DenyOperationButton" Content="拒绝" Click="DenyOperation_Click" Margin="0,0,6,0" FontSize="12"/>
      <Button x:Name="AllowOperationButton" Content="允许" Click="AllowOperation_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" FontSize="12"/>
      <Button Content="取消任务" Click="CancelOperation_Click" FontSize="12"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <!-- Composer -->
   <Border x:Name="ComposerPanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,10,12,12">
    <StackPanel>
     <TextBlock x:Name="NoticeText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" FontSize="11"/>
     <WrapPanel x:Name="AttachmentsPanel" Margin="0,0,0,5"/>
     <Border Background="{DynamicResource Page}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="2">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <Button x:Name="AttachButton" Style="{StaticResource IconButton}" Content="📎" Click="Attach_Click" ToolTip="添加附件" FontSize="15" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
       <TextBox x:Name="PromptBox" Grid.Column="1" MinHeight="50" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8,10" AutomationProperties.Name="任务描述" TextChanged="Prompt_TextChanged" ToolTip="Ctrl+Enter 发送" FontSize="13" Background="Transparent" BorderThickness="0"/>
       <Button x:Name="SendButton" Grid.Column="2" Content="➤" Click="Send_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,4,2" Padding="10,8" FontSize="15" ToolTip="发送 (Ctrl+Enter)"/>
      </Grid>
     </Border>
     <DockPanel Margin="0,6,0,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="授权" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
       <ComboBox x:Name="AccessModeCombo" Width="92" Height="26" AutomationProperties.Name="工具授权模式">
        <ComboBoxItem Content="询问模式" Tag="ask"/>
        <ComboBoxItem Content="完全访问" Tag="full"/>
       </ComboBox>
       <CheckBox x:Name="AllowWrites" Content="允许写入" VerticalAlignment="Center" ToolTip="预先启用写入能力" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock x:Name="DestinationText" Text="Ctrl+Enter 发送" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </StackPanel>
   </Border>
  </StackPanel>
 </Grid>
</UserControl>
