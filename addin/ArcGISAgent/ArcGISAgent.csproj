<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ArcGISAgent</AssemblyName>
    <RootNamespace>ArcGISAgent</RootNamespace>
    <ArcGISProBin Condition="'$(ArcGISProBin)' == ''">E:\programs\ArcGIS\bin</ArcGISProBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ArcGIS.Core"><HintPath>$(ArcGISProBin)\ArcGIS.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Framework"><HintPath>$(ArcGISProBin)\ArcGIS.Desktop.Framework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Core"><HintPath>$(ArcGISProBin)\Extensions\Core\ArcGIS.Desktop.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Mapping"><HintPath>$(ArcGISProBin)\Extensions\Mapping\ArcGIS.Desktop.Mapping.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ArcGIS.Desktop.Catalog"><HintPath>$(ArcGISProBin)\Extensions\Catalog\ArcGIS.Desktop.Catalog.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
